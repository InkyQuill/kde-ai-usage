#!/usr/bin/env bash
set -u

API_KEY="${WIDGET_ZAI_TOKEN:-}"
[ -z "$API_KEY" ] && [ -n "${ZAI_TOKEN:-}" ] && API_KEY="$ZAI_TOKEN"
[ -z "$API_KEY" ] && [ -n "${HOME:-}" ] && [ -f "$HOME/.config/zai/token" ] && API_KEY=$(tr -d '\n\r ' < "$HOME/.config/zai/token" 2>/dev/null)

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

# Auto-detect tokens from the ZCode app credential store as a last resort.
TOKEN_SOURCE="api"
ZCODE_TOKENS=""
ZCODE_CREDS="${WIDGET_ZCODE_CREDENTIALS:-${HOME:-}/.zcode/v2/credentials.json}"
if [ -z "$API_KEY" ] && [ -f "$ZCODE_CREDS" ] && command -v python3 >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    ZCODE_TOKENS=$("$SCRIPT_DIR/zcode-credentials" "$ZCODE_CREDS" 2>/dev/null || true)
    API_KEY=$(jq -r '.access_token // empty' <<<"$ZCODE_TOKENS" 2>/dev/null)
    if [ -n "$API_KEY" ]; then
        TOKEN_SOURCE="zcode"
    else
        ZCODE_TOKENS=""
    fi
fi

if [ -z "$API_KEY" ]; then
    echo "{}"
    exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
    printf '%s\n' '{"zaiToken":"","keyValid":false,"error":"jq is required"}'
    exit 0
fi

QUOTA_URL="https://api.z.ai/api/monitor/usage/quota/limit"
BALANCE_URL="https://zcode.z.ai/api/v1/zcode-plan/billing/balance?app_version=3.7.7"

fetch() {
    local url=$1 auth=$2
    curl -s -w "\n%{http_code}" \
        -H "Authorization: $auth" \
        -H "Accept: application/json" \
        -H "User-Agent: kde-ai-usage/zai" \
        --max-time 10 \
        "$url" 2>/dev/null
}

if [ -n "${ZAI_RESPONSE_FILE:-}" ] && [ -f "${ZAI_RESPONSE_FILE:-}" ]; then
    BODY=$(< "$ZAI_RESPONSE_FILE")
    HTTP_CODE=200
else
    RESPONSE=$(fetch "$QUOTA_URL" "Bearer $API_KEY")
    HTTP_CODE="${RESPONSE##*$'\n'}"
    BODY="${RESPONSE%$'\n'*}"
fi

# Free Start Plan token buckets from the ZCode app (only reachable with the
# app's own JWT, so only fetched for auto-detected credentials).
START_PLAN="null"
if [ "$TOKEN_SOURCE" = "zcode" ]; then
    ZCODE_JWT=$(jq -r '.zcode_jwt // empty' <<<"$ZCODE_TOKENS" 2>/dev/null)
    if [ -n "$ZCODE_JWT" ]; then
        if [ -n "${ZCODE_BALANCE_RESPONSE_FILE:-}" ] && [ -f "${ZCODE_BALANCE_RESPONSE_FILE:-}" ]; then
            BAL_BODY=$(< "$ZCODE_BALANCE_RESPONSE_FILE")
            BAL_CODE=200
        else
            BAL_RESPONSE=$(fetch "$BALANCE_URL" "Bearer $ZCODE_JWT")
            BAL_CODE="${BAL_RESPONSE##*$'\n'}"
            BAL_BODY="${BAL_RESPONSE%$'\n'*}"
        fi
        if [ "$BAL_CODE" = "200" ]; then
            START_PLAN=$(jq -c '
                if ((.data.plans // []) | map(select(.status == "active")) | length) > 0
                   and ((.data.balances // []) | length) > 0 then
                    {
                        name: ((.data.plans // []) | map(select(.status == "active")) | .[0].name // ""),
                        balances: [
                            .data.balances[]
                            | select((.total_units // 0) > 0)
                            | {
                                model: (.show_name // "model"),
                                used: (.used_units // 0),
                                total: .total_units,
                                resetMs: ((.period_end // 0) * 1000)
                            }
                        ]
                    }
                else null end' <<<"$BAL_BODY" 2>/dev/null || echo "null")
        fi
    fi
fi

invalid_token_error() {
    if [ "$TOKEN_SOURCE" = "zcode" ]; then
        echo "ZCode session expired — log in again in the ZCode app"
    else
        echo "Invalid Z.AI token"
    fi
}

case "$HTTP_CODE" in
    200)
        if ! jq --arg key "$API_KEY" --arg source "$TOKEN_SOURCE" --argjson startPlan "$START_PLAN" '
            if (.success == false) then
                if $startPlan != null then
                    {
                        zaiToken: $key,
                        keyValid: true,
                        tokenSource: $source,
                        quota: null,
                        startPlan: $startPlan
                    }
                else
                    {
                        zaiToken: "",
                        keyValid: false,
                        error: (.msg // "Z.AI API error")
                    }
                end
            elif (.data | type) == "object" and (.data.limits | type) == "array" then
                (.data // {}) as $d |
                (($d.limits // []) | map(select(.type == "TOKENS_LIMIT"))[0] // {}) as $tok |
                (($d.limits // []) | map(select(.type == "TIME_LIMIT"))[0] // {}) as $tools |
                {
                    zaiToken: $key,
                    keyValid: true,
                    tokenSource: $source,
                    level: ($d.level // ""),
                    quota: {limits: ($d.limits // []), level: ($d.level // "")},
                    startPlan: $startPlan,
                    tokenPct: ($tok.percentage // 0),
                    tokenResetMs: ($tok.nextResetTime // null),
                    tokenUsed: ($tok.used // $tok.usage // null),
                    tokenLimit: ($tok.limit // $tok.total // null),
                    toolsPct: ($tools.percentage // 0),
                    toolsRemaining: ($tools.remaining // null),
                    toolsResetMs: ($tools.nextResetTime // null),
                    models: ($tools.usageDetails // [])
                }
            elif $startPlan != null then
                {
                    zaiToken: $key,
                    keyValid: true,
                    tokenSource: $source,
                    quota: null,
                    startPlan: $startPlan
                }
            else
                {
                    zaiToken: "",
                    keyValid: false,
                    error: "Z.AI unexpected response"
                }
            end' <<<"$BODY" 2>/dev/null; then
            jq -n '{zaiToken: "", keyValid: false, error: "Z.AI invalid JSON"}'
        fi
        ;;
    401|403)
        jq -n --arg key "$API_KEY" --arg source "$TOKEN_SOURCE" --arg msg "$(invalid_token_error)" \
            '{zaiToken: $key, keyValid: false, tokenSource: $source, error: $msg}'
        ;;
    000)
        jq -n '{zaiToken: "", keyValid: false, error: "Z.AI network error"}'
        ;;
    *)
        jq -n --arg code "$HTTP_CODE" '{zaiToken: "", keyValid: false, error: ("Z.AI HTTP " + $code)}'
        ;;
esac
